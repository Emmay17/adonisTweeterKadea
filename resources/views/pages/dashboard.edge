                <div>
                    <div>
                        <img src="/public/profile_photo.jpeg">
                        <div>
                            <div>
                                <p>The New York Times</p>
                                <img src="/public/Group.svg">
                            </div>
                            <p>@nytimes</p>
                        </div>
                        <button>
                            Follow
                        </button>
                    </div>

                    <div>
                        <img src="/public/profile_photo.jpeg">
                        <div>
                            <div>
                                <p>CNN</p>
                                <img src="/public/Group.svg">
                            </div>
                            <p>@CNN</p>
                        </div>
                        <button>
                            Follow
                        </button>
                    </div>

                    <div>
                        <img src="/public/profile_photo.jpeg">
                        <div>
                            <div>
                                <p>Tweeter</p>
                                <img src="/public/Group.svg">
