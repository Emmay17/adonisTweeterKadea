<nav>
<ul >
    @if(postes && postes.length > 0)
    
    @each (item in postes)
    <li class="flex flex-row gap-3 p-4 post" data-id="{{item.id_post}}">
        <div>
            <img src="{{item.user.img}}" alt="img profile" class="w-12 h-12 rounded-full object-cover">
        </div>

        <div class="flex flex-col gap-3 w-[80%] flex-grow">
            <!-- Header with user info -->
            <div class="flex gap-2 items-center">
                <p class="font-semibold">{{ item.user.prenom}} {{item.user.nom}}</p>
                <img src="/Group.svg" alt="checkIcon" class="w-5 h-5">
                <span class="text-gray-500">{{ item.user.username }}.</span>
                <span class="text-gray-500">2h</span>
            </div>

            <!-- Content of the post -->
            <div>
                <p class="flex-grow text-white h-auto whitespace-pre-line overflow-scroll max-h-40">
                    {{ item.content }}
                </p>
            </div>

            <!-- Image in the post (if any) -->
            @if(item.image)
            <img src="{{ item.image }}" alt="post image" class="w-full mt-3 object-cover imgPost">
            @endif

            <!-- Interaction section (comments, retweets, likes, share) -->
            <nav class="w-full">
                @!component('pages/components/reactionBtn', {item})
            </nav>
        </div>
    </li>
    @endeach

    @else
    <div class="w-full p-4 flex justify-center items-center">
        <p class="text-lg font-bold text-gray-500">Aucun post pour le moment</p>
    </div>
    @end
</ul>
</nav>